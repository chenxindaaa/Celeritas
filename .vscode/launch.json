{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "gdb",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/test/test_celeritas",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build-debug-all",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Add GCC Python pretty-printer path",
                    "text": "interpreter-exec console \"python import sys; sys.path.insert(0, '/usr/share/gcc/python')\"",
                    "ignoreFailures": true
                },
                {
                    "description": "Register libstdc++ pretty-printers",
                    "text": "interpreter-exec console \"python from libstdcxx.v6.printers import register_libstdcxx_printers; register_libstdcxx_printers(None)\"",
                    "ignoreFailures": true
                },
                {
                    "description": "Improve STL display formatting",
                    "text": "interpreter-exec console \"set print pretty on\"",
                    "ignoreFailures": true
                }
            ]
        },
