{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure-debug-test_celeritas",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "test",
        "-B",
        "build/debug",
        "-DCMAKE_BUILD_TYPE=Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "build-debug-test_celeritas",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build/debug",
        "--target",
        "test_celeritas",
        "-j",
        "32"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": [
        "configure-debug-test_celeritas"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
